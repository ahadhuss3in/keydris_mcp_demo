# ---------------------------------------------------------------------------
# Governed SecOps Agent — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# OpenRouter API key. Used BOTH for the investigator LLM and for Jev
# (Jev is a TypeSafe System One model served through OpenRouter).
OPENROUTER_API_KEY=sk-or-...

# OpenRouter base URL for chat completions AND the System One decisions API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Investigator LLM (the "System 2" reasoning node in LangGraph).
LLM_MODEL_NAME=deepseek/deepseek-v4.1-flash

# Jev / TypeSafe model used by the Judge node (typed Choice primitive).
TYPESAFE_MODEL_NAME=typesafe/jev-1.13

# Optional tuning -----------------------------------------------------------
# Path appended to OPENROUTER_BASE_URL for the System One decisions endpoint.
# Defaults to `/systemone` => https://openrouter.ai/api/v1/systemone
# JEV_PATH=/systemone

# Containment gate: malicious verdicts auto-execute only above this confidence.
# KEYDRIS_AUTO_BLOCK_MIN_CONFIDENCE=0.90

# MCP transport for the enforcer: `stdio` or `inprocess`.
# ENFORCER_TRANSPORT=stdio